<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Dashboard"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#222222"/>



        <!-- TOTAL REPORTS CARD -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Reports"
                    android:textSize="16sp"
                    android:textColor="#666666"/>

                <TextView
                    android:id="@+id/txtTotalReports"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#2962FF"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>



        <!-- TOTAL EMPLOYEES -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Attendance"
                    android:textSize="16sp"
                    android:textColor="#666666"/>

                <TextView
                    android:id="@+id/txtTotalAttendance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#FF6D00"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Employees"
                    android:textSize="16sp"
                    android:textColor="#666666"/>

                <TextView
                    android:id="@+id/txtTotalEmployees"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#00C853"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>



        <!-- BUTTONS -->

        <Button
            android:id="@+id/btnAllReports"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="View All Reports"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:layout_marginTop="30dp"
            android:backgroundTint="#2962FF"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnAttendanceMonitor"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Attendance Monitor"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:layout_marginTop="16dp"
            android:backgroundTint="#00C853"
            android:textColor="#FFFFFF"/>
        <Button
            android:id="@+id/btnAddEmployee"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Add Employee"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:layout_marginTop="16dp"
            android:backgroundTint="#FF6D00"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnLogoutAdmin"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Logout"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:layout_marginTop="16dp"
            android:backgroundTint="#D50000"
            android:textColor="#FFFFFF"/>
        <Button
            android:id="@+id/btnViewEmployees"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="View Employees"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:layout_marginTop="16dp"
            android:backgroundTint="#7B1FA2"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</ScrollView>